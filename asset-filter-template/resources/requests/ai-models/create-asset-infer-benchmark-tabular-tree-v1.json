{
  "@context": {
    "@vocab": "https://w3id.org/edc/v0.0.1/ns/",
    "dct": "http://purl.org/dc/terms/",
    "dcterms": "http://purl.org/dc/terms/",
    "dcat": "http://www.w3.org/ns/dcat#",
    "daimo": "https://w3id.org/pionera/daimo#"
  },
  "@id": "provider~benchmark-tabular-tree-v1",
  "properties": {
    "name": "Benchmark Tabular Tree v1",
    "description": "HTTP inference benchmark service using a tree-based tabular regressor.",
    "version": "1.0.0",
    "contenttype": "application/json",
    "assetData": {
      "JS_DAIMO_Model": {
        "daimo:taskCategory": "tabular-regression",
        "daimo:taskType": "regression",
        "daimo:subtask": [
          "risk-scoring"
        ],
        "daimo:software": [
          "Python 3.11"
        ],
        "daimo:modelVersion": "1.0.0",
        "daimo:libraryName": "custom-python",
        "daimo:inferencePath": "/infer",
        "daimo:inputSchemaDraft": "https://json-schema.org/draft/2020-12/schema",
        "daimo:inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "urn:pionera:schema:tabular-regression:v1",
          "title": "Tabular Regression Input",
          "type": "object",
          "properties": {
            "age": {
              "type": "integer",
              "minimum": 18,
              "maximum": 100,
              "description": "Age in years."
            },
            "income": {
              "type": "number",
              "minimum": 0,
              "description": "Annual income in USD."
            },
            "tenure_months": {
              "type": "integer",
              "minimum": 0,
              "description": "Customer tenure in months."
            }
          },
          "required": [
            "age",
            "income",
            "tenure_months"
          ],
          "additionalProperties": false
        },
        "daimo:inputExample": {
          "age": 29,
          "income": 55000,
          "tenure_months": 6
        }
      }
    },
    "dcat:keyword": [
      "inference",
      "benchmark",
      "tabular",
      "regression"
    ],
    "dct:license": "Apache-2.0",
    "dct:format": "json-api"
  },
  "dataAddress": {
    "type": "HttpData",
    "baseUrl": "http://localhost:9302",
    "proxyPath": "true"
  }
}
